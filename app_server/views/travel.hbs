<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html lang="en">
<head>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta charset="UTF-8">
	<title>{{title}}</title>
	<link rel="stylesheet" href="/css/style.css" type="text/css">
	<link rel="icon" type="image/png" href="/images/Bird_Oragami.png">
</head>
<body>
	<div id="background">
		<div id="page">
			<div id="header">
				<div id="logo">
					<a href="/index.html"><img class="logo-full" src="/images/logo.png" alt="Travlr Getaways" height="200" width="200"><img class="logo-bird" src="/images/Bird_Oragami.png" alt="Travlr Getaways" height="200" width="200"><span class="logo-wordmark"><span class="logo-brand">Travlr</span><span class="logo-subbrand">getaways</span></span></a>
				</div>
				<div id="navigation">
					<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
						<span class="nav-toggle-icon" aria-hidden="true">
							<span class="nav-toggle-bar"></span>
							<span class="nav-toggle-bar"></span>
							<span class="nav-toggle-bar"></span>
						</span>
						<span class="nav-toggle-label">Menu</span>
					</button>
					<ul id="primary-navigation">
						<li>
							<a href="/index.html">Home</a>
						</li>
						<li class="selected">
							<a href="/travel">Travel</a>
						</li>
						<li>
							<a href="/rooms.html">Rooms</a>
						</li>
						<li>
							<a href="/meals.html">Dining</a>
						</li>
						<li>
							<a href="/news.html">News</a>
						</li>
						<li>
							<a href="/about.html">About</a>
						</li>
						<li>
							<a href="/contact.html">Contact</a>
						</li>
					</ul>
				</div>
			</div>
			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							<div class="travel-intro">
								<h1>Travel, beautifully arranged.</h1>
								<p>Every package pairs a considered stay with a slower route through the mountains. Your room, timing, and travel rhythm are planned together.</p>
							</div>
							{{#if message}}
							<p class="travel-message">{{message}}</p>
							{{/if}}
							<ul id="sites">
								{{#each trips}}
								<li>
									<a href="/travel/{{this.code}}"><img src="/images/{{this.image}}" onerror="this.onerror=null;this.src='/images/Travel.jpg';" alt="{{this.name}}"></a>
									<h2><a href="/travel/{{this.code}}">{{this.name}}</a></h2>
									<div class="travel-card-description">{{{this.description}}}</div>
									<div class="travel-card-meta"><span>{{this.length}}</span><span>Stay at {{this.resort}}</span>{{#if this.startDate}}<span>Departs {{this.startDate}}</span>{{/if}}<span>{{this.perPerson}}</span></div>
									<div class="travel-card-actions"><a class="booking-button" href="/travel/{{this.code}}#availability">Check package availability</a></div>
								</li>
								{{/each}}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
		{{> footer }}
	</div>
	<script src="/js/navigation.js"></script>
</body>
</html>
