<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html lang="en">
<head>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta charset="UTF-8">
	<title>{{title}}</title>
	<link rel="stylesheet" href="/css/style.css" type="text/css">
	<link rel="icon" type="image/png" href="/images/Bird_Oragami.png">
</head>
<body>
	<div id="background">
		<div id="page">
			<div id="header">
				<div id="logo">
					<a href="/index.html"><img class="logo-full" src="/images/logo.png" alt="Travlr Getaways" height="200" width="200"><img class="logo-bird" src="/images/Bird_Oragami.png" alt="Travlr Getaways" height="200" width="200"><span class="logo-wordmark"><span class="logo-brand">Travlr</span><span class="logo-subbrand">getaways</span></span></a>
				</div>
				<div id="navigation">
					<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
						<span class="nav-toggle-icon" aria-hidden="true">
							<span class="nav-toggle-bar"></span>
							<span class="nav-toggle-bar"></span>
							<span class="nav-toggle-bar"></span>
						</span>
						<span class="nav-toggle-label">Menu</span>
					</button>
					<ul id="primary-navigation">
						<li>
							<a href="/index.html">Home</a>
						</li>
						<li class="selected">
							<a href="/travel">Travel</a>
						</li>
						<li>
							<a href="/rooms.html">Rooms</a>
						</li>
						<li>
							<a href="/meals.html">Dining</a>
						</li>
						<li>
							<a href="/news.html">News</a>
						</li>
						<li>
							<a href="/about.html">About</a>
						</li>
						<li>
							<a href="/contact.html">Contact</a>
						</li>
					</ul>
				</div>
			</div>
			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							{{#if message}}
							<div class="travel-detail-message">
								<h1>Travel</h1>
								<p>{{message}}</p>
								<a href="/travel">Back to Travel</a>
							</div>
							{{/if}}
							{{#if trip}}
							<article class="travel-detail">
								<a class="travel-back" href="/travel">Back to Travel</a>
								<img class="travel-detail-image" src="/images/{{trip.image}}" onerror="this.onerror=null;this.src='/images/Travel.jpg';" alt="{{trip.name}}">
								<div class="travel-detail-content">
									<div>
										<p class="travel-detail-code">Curated package · {{trip.code}}</p>
										<h1>{{trip.name}}</h1>
									</div>
									<div class="travel-detail-meta">
										<p><span>Package length</span>{{trip.length}}</p>
										<p><span>Departure</span>{{trip.startDate}}</p>
										<p><span>Your stay</span>{{trip.resort}}</p>
										<p><span>Package from</span>{{trip.perPerson}}</p>
									</div>
									<div class="travel-detail-description">
										{{{trip.description}}}
									</div>
									<section class="package-includes">
										<h2>Your package includes</h2>
										<ul>
											<li><strong>{{trip.length}}</strong> based at {{trip.resort}}</li>
											<li>A paced itinerary shaped around the destination</li>
											<li>Concierge support to tailor the details before you go</li>
										</ul>
									</section>
									<section class="booking-panel" id="availability">
										<h2>Check package availability</h2>
										<p>Tell us when you’d like to travel and we’ll confirm the stay and package timing within 24 hours.</p>
										{{#if bookingSuccess}}<p class="booking-success">Your request is in. We’ll be in touch shortly.</p>{{/if}}
										{{#if bookingError}}<p class="booking-error">{{bookingError}}</p>{{/if}}
										<form method="post" action="/travel/{{trip.code}}/request">
											<label for="name">Your name</label><input id="name" name="name" value="{{bookingValues.name}}" required>
											<label for="email">Email address</label><input id="email" name="email" type="email" value="{{bookingValues.email}}" required>
											<label for="travelers">Travelers</label><input id="travelers" name="travelers" type="number" min="1" value="{{bookingValues.travelers}}" required>
											<label for="preferredDate">Preferred departure</label><input id="preferredDate" name="preferredDate" type="date" value="{{bookingValues.preferredDate}}">
											<label for="message">Anything we should know?</label><textarea id="message" name="message" rows="4">{{bookingValues.message}}</textarea>
											<button class="booking-button" type="submit">Request this package</button>
										</form>
										<p class="booking-note">Small-group departures, tailored timing, and a response within 24 hours.</p>
									</section>
								</div>
							</article>
							{{/if}}
						</div>
					</div>
				</div>
			</div>
		</div>
		{{> footer }}
	</div>
	<script src="/js/navigation.js"></script>
</body>
</html>
