#!/usr/bin/env node

require('dotenv').config();

const required = ['ADMIN_NAME', 'ADMIN_EMAIL', 'ADMIN_PASSWORD'];
const missing = required.filter((key) => !process.env[key]);

if (missing.length) {
  console.error(`Unable to reset admin: Missing required environment values: ${missing.join(', ')}`);
  process.exit(1);
}

if (process.env.ADMIN_PASSWORD.length < 12) {
  console.error('Unable to reset admin: ADMIN_PASSWORD must be at least 12 characters long.');
  process.exit(1);
}

const mongoose = require('mongoose');
require('../app_api/models/db');
const User = require('../app_api/models/user');

const resetAdmin = async () => {
  await mongoose.connection.asPromise();
  const email = process.env.ADMIN_EMAIL.trim().toLowerCase();
  const admin = await User.findOne({ email }).select('+hash +salt');
  if (!admin) {
    throw new Error(`No account exists for ${email}. Run npm run seed:admin first.`);
  }

  admin.name = process.env.ADMIN_NAME.trim();
  admin.role = 'admin';
  await admin.setPassword(process.env.ADMIN_PASSWORD);
  await admin.save();
  console.log(`Password reset for ${email}.`);
};

resetAdmin()
  .catch((err) => {
    console.error(`Unable to reset admin: ${err.message}`);
    process.exitCode = 1;
  })
  .finally(() => mongoose.connection.close());
